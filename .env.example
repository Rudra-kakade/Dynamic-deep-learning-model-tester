# --- Database ---
DATABASE_URL=postgresql+psycopg2://vuln_user:vuln_pass@localhost:5432/vuln_platform

# --- Async job queue ---
REDIS_URL=redis://localhost:6379/0

# --- Artifact storage (S3-compatible; MinIO for local dev) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=vuln-platform-artifacts

# --- Sandbox (Module 1, Section 6.2 / 7.2 - hard requirement, not optional) ---
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT_MB=2048
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_NETWORK_DISABLED=true

# --- Adaptive orchestration (Module 4, Section 10.2/13.2) ---
BANDIT_POLICY=ucb          # or thompson_sampling
BANDIT_TOTAL_QUERY_BUDGET=500
BANDIT_COVERAGE_FLOOR_PCT=0.15

# --- App ---
SECRET_KEY=change-me
ENVIRONMENT=development

# --- Agent Testing (Module 5) ---
AGENT_TEST_TIMEOUT_SECONDS=300
AGENT_MAX_STEPS_PER_SCENARIO=50
LLM_JUDGE_MODEL=gpt-4
LLM_JUDGE_API_KEY=

# --- RAG Testing (Module 6) ---
RAG_TEST_TIMEOUT_SECONDS=120
RAGAS_LLM_MODEL=gpt-4
RAGAS_EMBEDDING_MODEL=text-embedding-3-small
